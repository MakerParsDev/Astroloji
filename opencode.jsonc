{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["opencode"],
  "provider": {
    "opencode": {
      "whitelist": [
        "muse-spark-1.3-contributor-free",
        "nemotron-3-ultra-free",
        "mimo-v2.6-flash-free",
        "nemotron-3.5-lightning-free",
        "ling-3.0-flash-fin-free",
        "mimo-v2.5-free",
        "big-pickle"
      ]
    }
  },
  "model": "opencode/muse-spark-1.3-contributor-free",
  "small_model": "opencode/nemotron-3.5-lightning-free",
  "default_agent": "maintainer",
  "subagent_depth": 2,
  "instructions": ["AGENTS.md", "docs/OPENCODE_AUTONOMY.md"],
  "share": "disabled",
  "snapshot": false,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".gradle/**",
      "**/build/**",
      "**/node_modules/**",
      "**/dist/**",
      ".opencode/node_modules/**"
    ]
  },
  "lsp": true,
  "mcp": {
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true,
      "timeout": 15000
    },
    "cloudflare-observability": {
      "type": "remote",
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "enabled": false,
      "timeout": 15000
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "skill": "allow",
    "lsp": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "deny",
    "doom_loop": "deny",
    "external_directory": "deny",
    "bash": {
      "*": "deny",
      "cd *": "allow",
      "pwd": "allow",
      "test *": "allow",
      "git status*": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git ls-remote*": "allow",
      "git grep*": "allow",
      "git grep *--no-index*": "deny",
      "git grep *--untracked*": "deny",
      "git grep *--no-exclude-standard*": "deny",
      "git merge-base*": "allow",
      "git blame*": "allow",
      "git check-attr*": "allow",
      "git branch --show-current*": "allow",
      "git remote -v*": "allow",
      "gh pr view*": "allow",
      "gh pr checks*": "allow",
      "gh issue view*": "allow",
      "gh run view*": "allow",
      "gh repo view*": "allow",
      "node --test *": "allow",
      "node scripts/scan-secrets.mjs*": "allow",
      "node scripts/select-opencode-free-model.mjs*": "allow",
      "node scripts/check-autonomous-diff.mjs*": "allow",
      "node scripts/validate-play-metadata.mjs*": "allow",
      "npm ci*": "allow",
      "npm test*": "allow",
      "npm run build*": "allow",
      "npm run test*": "allow",
      "npm run lint*": "allow",
      "npm run check*": "allow",
      "npm run typecheck*": "allow",
      "npm run types:check*": "allow",
      "npm run types:generate*": "allow",
      "./gradlew *": "allow",
      ".\\gradlew *": "allow",
      ".\\gradlew.bat *": "allow",
      "./gradlew *publish*": "deny",
      "./gradlew *promote*": "deny",
      "./gradlew *upload*": "deny",
      ".\\gradlew *publish*": "deny",
      ".\\gradlew *promote*": "deny",
      ".\\gradlew *upload*": "deny",
      ".\\gradlew.bat *publish*": "deny",
      ".\\gradlew.bat *promote*": "deny",
      ".\\gradlew.bat *upload*": "deny"
    }
  }
}
