{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["opencode"],
  "provider": {
    "opencode": {
      "whitelist": [
        "muse-spark-1.3-contributor-free",
        "nemotron-3-ultra-free",
        "mimo-v2.6-flash-free",
        "nemotron-3.5-lightning-free",
        "ling-3.0-flash-fin-free",
        "mimo-v2.5-free",
        "jev-1.13-free",
        "big-pickle"
      ]
    }
  },
  "model": "opencode/muse-spark-1.3-contributor-free",
  "small_model": "opencode/nemotron-3.5-lightning-free",
  "default_agent": "maintainer",
  "subagent_depth": 2,
  "instructions": ["AGENTS.md", "docs/OPENCODE_AUTONOMY.md"],
  "share": "disabled",
  "snapshot": false,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".gradle/**",
      "**/build/**",
      "**/node_modules/**",
      "**/dist/**",
      ".opencode/node_modules/**"
    ]
  },
  "lsp": true,
  "mcp": {
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true,
      "timeout": 15000
    },
    "cloudflare-observability": {
      "type": "remote",
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "enabled": false,
      "timeout": 15000
    }
  },
  "permission": {
    "*": "allow",
    "external_directory": "deny",
    "lsp": "allow",
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "gh secret *": "deny",
      "gh variable *": "deny",
      "doppler *": "deny",
      "*wrangler deploy*": "deny",
      "*wrangler*d1*--remote*": "deny",
      "*publishReleaseBundle*": "deny",
      "*promoteReleaseArtifact*": "deny",
      "*npm run deploy*": "deny"
    }
  }
}
